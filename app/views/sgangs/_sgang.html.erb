<tr class="text-center" id="<%= dom_id sgang %>">
  <td><%= sgang.first_name %></td>
  <td><%= sgang.last_name %></td>
  <td><%= sgang.phone %></td>
  <td><%= sgang.facebook %></td>
  <td>
    <%= link_to "Show", sgang, class: "btn btn-sm btn-outline-success" %>
  </td>
  <td>
    <%= link_to "Edit", edit_sgang_path(sgang), class: "btn btn-sm btn-outline-primary" %>
  </td>
  <td>
    <%= link_to "Destroy", @sgang,
        method: :delete,
        data: { confirm: "Are you sure?" },
        class: "btn btn-sm btn-outline-danger" %>
  </td>
</tr>