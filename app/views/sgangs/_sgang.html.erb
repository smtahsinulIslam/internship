<tr class="text-center" id="<%= dom_id sgang %>">
  <td>
    <%= link_to sgang.first_name 
    + " " + 
    sgang.last_name, sgang %>
  </td>
  <td>
    <%= sgang.first_name %>
  </td>
  <td>
    <%= sgang.phone %>
  </td>
  <td>
    <%= sgang.facebook %>
  </td>
  <td>
    <%= sgang.user_id %>
  </td>

  <% if user_signed_in? %>
    <td>
      <%= link_to "Edit", edit_sgang_path(sgang), class: "btn btn-sm btn-outline-primary" %>
    </td>
    <td>
    <%= link_to "Destroy", sgang,
        data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
        class: "btn btn-sm btn-outline-danger" %>
    </td>
    
<% end %>
</tr>
