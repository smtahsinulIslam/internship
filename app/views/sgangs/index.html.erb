<% content_for :title, "Savage Gang" %>

<h1>Member List</h1>

<div class="table-responsive">

<table class="table table-striped table-bordered table-hover table-sm">
  <thead class="thead-dark text-center">
    <tr>
      <th><strong>SL</strong></th>
      <th><strong>Full name</strong></th>
      <th><strong>Phone</strong></th>
      <th><strong>Facebook</strong></th>
      <th><strong>User</strong></th>
      <% if user_signed_in? %>
        <th colspan="2"><strong>More</strong></th>
        <%# <th><strong>Update</strong></th>
        <th><strong>Delete</strong></th> %>
      <% end %>

    </tr> 
  </thead>
  <%#  3:21 %>
  <tbody>
    <% @sgangs.each_with_index do |sgang, index| %>

      <%= render partial: "sgang", locals: { sgang: sgang, index: index } %>

    <% end %>
  </tbody>
</table>
</div>

<%= link_to "New member", new_sgang_path, class:"btn btn-primary" %>
<br>
<div class="d-flex justify-content-center mt-3 pagination pagination-lg page-item page-link">
  <%= paginate @sgangs %>
</div>
<br>