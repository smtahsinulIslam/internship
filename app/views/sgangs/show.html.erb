<div class="jumbotron">
  <h1 class="display-4">
    <%= @sgang.first_name %>
    <%= @sgang.last_name %>
  </h1>
  <p class="lead">      
      <%= @sgang.phone %>  | 
      
      <%= @sgang.facebook %> 
  </p>
  <hr>

<div>
  <% if user_signed_in? %>
    <%= link_to "Edit this member", edit_sgang_path(@sgang), class:"btn btn-secondary" %> 
  <% end %>

  <%= link_to "Back to list", sgangs_path, class:"btn btn-secondary" %>
<br><br>
<% if user_signed_in? %>
  <%= button_to "Destroy this member", 
  @sgang, 
  method: :delete, 
  data: { turbo_confirm: "Are you sure?" },
  class:"btn btn-danger" %>
<% end %>

</div>
</div>


